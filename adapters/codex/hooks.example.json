{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "command": "mam recover", "timeout": 5},
          {"type": "command", "command": "mam context", "timeout": 5},
          {"type": "command", "command": "mam protocol", "timeout": 5}
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "command": "mam pending --session-id codex --summary-file \"$AGENT_MEMORY_SUMMARY_FILE\" >/dev/null", "timeout": 5}
        ]
      }
    ]
  }
}
